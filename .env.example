# ─────────────────────────────────────────────────────────────────────────────
# TODAS AS VARIÁVEIS SÃO OPCIONAIS.
#
# O deploy funciona sem nenhuma delas: a aplicação sobe, /health responde 200,
# a UI mostra a página de estado e /admin fica disponível.
#
# Este arquivo é copiado automaticamente pelo EasyPanel para o editor de
# Environment quando o repositório não tem .env. Por isso NADA está ativo aqui:
# valores preenchidos virariam configuração de produção sem querer.
# ─────────────────────────────────────────────────────────────────────────────

# Porta e host internos. Já definidos no Dockerfile (3000 / 0.0.0.0).
# PORT=3000
# HOST=0.0.0.0

# PostgreSQL. Sem valor, a administração da base fica desligada e o app roda
# só com o DuckDB (ou em modo degradado, se ele não existir).
# DATABASE_URL=postgres://usuario:senha@host:5432/banco?sslmode=disable

# Token do painel /admin. Sem valor, o painel não exige autenticação.
# ADMIN_TOKEN=

# Caminho do diretório de dados (volume). Padrão no Dockerfile: /data
# DATA_DIR=/data
# DUCKDB_PATH=/data/cnpj.duckdb
# APP_DB_PATH=/data/app.duckdb
# DUCKDB_TEMP_DIR=/data/tmp

# DuckDB: limites de memória e paralelismo.
# MEMORY_LIMIT=8GB
# THREADS=8

# Fonte dos dados abertos. Já tem padrão no código.
# SOURCE_BASE=https://arquivos.receitafederal.gov.br/public.php/webdav
# SOURCE_TOKEN=YggdBLfdninEJX9
# SNAPSHOT=2026-10

# Download: use_aria2=false força o downloader em Node.
# USE_ARIA2=false
# ARIA2_CONNECTIONS=4
# ARIA2_JOBS=2
# DOWNLOAD_PARALLEL=2
