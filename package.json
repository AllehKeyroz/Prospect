{
  "name": "cnpj-prospect",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MVP interno de analise de mercado e concorrentes com dados abertos de CNPJ",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/api/server.ts",
    "start": "node dist/src/api/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:up": "docker compose -f docker-compose.db.yml up -d",
    "db:down": "docker compose -f docker-compose.db.yml down",
    "db:logs": "docker compose -f docker-compose.db.yml logs -f postgres",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:load:sample": "tsx src/db/loadSnapshot.ts --sample",
    "db:load:snapshot": "tsx src/db/loadSnapshot.ts",
    "geo:build": "tsx src/geo/buildGeo.ts",
    "sample": "tsx src/ingest/makeSample.ts",
    "prepare:snapshot": "tsx src/ingest/prepareSnapshot.ts",
    "ingest:sample": "tsx src/ingest/loadSample.ts",
    "ingest:snapshot": "tsx src/ingest/loadSnapshot.ts",
    "history:download-2019": "tsx src/history/downloadWayback2019.ts",
    "history:validate-2019": "tsx src/history/validateWayback2019.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@duckdb/node-api": "^2.0.0-r.1",
    "@fastify/cors": "^11.4.3",
    "@fastify/static": "^10.1.11",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.10",
    "fastify": "^5.12.8",
    "iconv-lite": "^0.7.3",
    "maplibre-gl": "^6.18.0",
    "pg": "^8.23.1",
    "pg-copy-streams": "^7.0.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/pg-copy-streams": "^1.2.5",
    "@types/yauzl": "^3.4.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
